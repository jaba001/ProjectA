# IDE / 개인 IDE 설정
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sdf
*.opensdf

# Unreal generated folders / 언리얼 자동 생성 폴더
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Unreal plugin generated folders / 언리얼 플러그인 자동 생성 폴더
Plugins/**/Binaries/
Plugins/**/Intermediate/

# OS / shortcut files / OS 및 바로가기 파일
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Ignore all Content assets by default / 기본적으로 Content 전체 무시
Content/*

# Keep user project content / User_JeHoon 콘텐츠만 추적
!Content/User_JeHoon/
!Content/User_JeHoon/**

# Track the imported mage staff without copying its source pack / 원본 팩 복제 없이 임포트한 지팡이 추적
!Content/MageStaff_FreeWeapons/
!Content/MageStaff_FreeWeapons/**

# Track montage slots on the original skeletons instead of copying meshes / 메시 복제 대신 원본 뼈대의 몽타주 슬롯 추적
!Content/GKnight/
Content/GKnight/*
!Content/GKnight/Meshes/
Content/GKnight/Meshes/*
!Content/GKnight/Meshes/SK_GothicKnight_Skeleton.uasset
!Content/Skeleton_Guard/
Content/Skeleton_Guard/*
!Content/Skeleton_Guard/Demoscene_UE4/
Content/Skeleton_Guard/Demoscene_UE4/*
!Content/Skeleton_Guard/Demoscene_UE4/Mesh/
Content/Skeleton_Guard/Demoscene_UE4/Mesh/*
!Content/Skeleton_Guard/Demoscene_UE4/Mesh/UE4_Mannequin_Skeleton.uasset

# Keep the selected imports in place when fixing scale and montage slots / 배율 및 몽타주 슬롯 수정은 선택한 임포트의 기존 위치에서 추적
!Content/Assassin/
Content/Assassin/*
!Content/Assassin/Mesh/
Content/Assassin/Mesh/*
!Content/Assassin/Mesh/SK_Assassin_Skeleton.uasset
!Content/stylized_dark_witch_fbx__extracted/
Content/stylized_dark_witch_fbx__extracted/*
!Content/stylized_dark_witch_fbx__extracted/Stylized_Dark_Witch.uasset
!Content/stylized_dark_witch_fbx__extracted/Stylized_Dark_Witch_Skeleton.uasset
!Content/stylized_dark_witch_fbx__extracted/Stylized_Dark_Witch_PhysicsAsset.uasset

# Restore original material regions in place without copying body meshes / 신체 메시 복제 없이 원래 경로에서 재질 영역 복원
!Content/ROG_Modular_Armor/
Content/ROG_Modular_Armor/*
!Content/ROG_Modular_Armor/Characters/
Content/ROG_Modular_Armor/Characters/*
!Content/ROG_Modular_Armor/Characters/UE5_Mannequins/
Content/ROG_Modular_Armor/Characters/UE5_Mannequins/*
!Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/
Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/*
!Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/Body_parts/
Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/Body_parts/*
!Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/Body_parts/SK_Manny_Head.uasset
!Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/Body_parts/SK_Manny_Arms.uasset
!Content/ROG_Modular_Armor/Characters/UE5_Mannequins/Manny/Body_parts/SK_Manny_Legs.uasset
